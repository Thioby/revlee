  "scenarios": [
    {
      "id": "S1",
      "title": "Adding a product to the cart shows a toast and increases the counter",
      "covers": [
        "B2",
        "B3",
        "B4"
      ],
      "preconditions": {
        "auth": "customer",
        "screen": "product",
        "data": "product 'Orchid Mantis' visible",
        "flags": {
          "newToast": true
        }
      },
      "steps": [
        {
          "n": 1,
          "action": "navigate",
          "text": "Go to the product screen for 'Orchid Mantis'",
          "expect_after": "title 'Orchid Mantis' and the 'Add to cart' button are visible"
        },
        {
          "n": 2,
          "action": "observe",
          "text": "Read the cart counter",
          "extract": {
            "name": "cart_before",
            "from": "testID cart-badge"
          }
        },
        {
          "n": 3,
          "action": "tap",
          "text": "Tap 'Add to cart'",
          "expect_after": "the toast 'Added: Orchid Mantis' appears"
        },
        {
          "n": 4,
          "action": "wait",
          "text": "Wait 3.5 s",
          "expect_after": "the toast has disappeared"
        }
      ],
      "oracles": [
        {
          "id": "O1",
          "type": "a11y_assert",
          "covers": "B2",
          "assert": {
            "text_contains": "Added: Orchid Mantis"
          },
          "at_step": 3,
          "expected_on_base": "absent"
        },
        {
          "id": "O2",
          "type": "a11y_assert",
          "covers": "B2",
          "assert": {
            "text_absent": "Added:"
          },
          "at_step": 4,
          "expected_on_base": "same"
        },
        {
          "id": "O3",
          "type": "state_assert",
          "covers": "B3",
          "assert": {
            "test_id": "cart-badge",
            "value_equals": "${cart_before + 1}"
          },
          "at_step": 4,
          "expected_on_base": "same"
        },
        {
          "id": "O4",
          "type": "vlm_rubric",
          "covers": "B4",
          "rubric": "The toast does not overlap the bottom tab bar; all 3 tab icons are fully visible",
          "vision": "required",
          "at_step": 3,
          "expected_on_base": "absent"
        }
      ],
      "negative_controls": [
        {
          "id": "N1",
          "text": "On the base build no toast appears after the tap",
          "compare_with_base": true
        },
        {
          "id": "N2",
          "text": "The counter does not increase by more than 1",
          "assert": {
            "test_id": "cart-badge",
            "value_not": "${cart_before + 2}"
          }
        }
      ],
      "compare_with_base": true,
      "budget": {
        "max_steps": 12,
        "max_model_calls": 20
      }
    },
