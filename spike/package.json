{
  "name": "@revlee/spike",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Revlee phase-0 spike: agentic PR verification loop on top of agent-device / Playwright",
  "bin": {
    "revlee-spike": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sample-app": "node sample-app/server.mjs",
    "verify": "node dist/cli.js verify",
    "bench": "bash bench/run.sh"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "agent-device": "^0.21.27",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.0"
  }
}
